  calendlyEventUri String
  email            String
  kind             String   // DAY_BEFORE | HOUR_BEFORE
  startTime        DateTime
  sentAt           DateTime @default(now())

  @@unique([calendlyEventUri, kind])
}

model Resource {
  id        String          @id @default(cuid())
  sectionId String
  section   Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type      String
  title     String
  url       String?
  filePath  String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  videoProgress VideoProgress[]
  /// Which cohort this belongs to. NULL means every cohort sees it, which is
  /// how every resource behaved before this column existed.
  ///
  /// Recordings and slide decks are the reason it is here. They hang off a
  /// Section, and a Section is global, so Fellowship 2's Module 4 recording
  /// appeared on Module 4 for every cohort — and recording the next one would
  /// have overwritten it rather than sitting beside it. Same idiom as
  /// LiveSession.cohortId, so a reader that forgets to filter degrades to
  /// showing everything rather than showing nothing.
  cohortId  String?
  cohort    Cohort?         @relation(fields: [cohortId], references: [id], onDelete: SetNull)
}

