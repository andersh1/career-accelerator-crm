generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Cohort {
  id        String           @id @default(cuid())
  name      String
  isActive  Boolean          @default(true)
  capacity  Int?
  startDate DateTime?
  createdAt DateTime         @default(now())
  users     User[]
  schedules CohortSchedule[]
}

model CohortSchedule {
  id              String   @id @default(cuid())
  cohortId        String
  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  preworkDue      DateTime?
  sessionDate     DateTime?
  sessionLocation String?
  sessionZoomLink String?

  @@unique([cohortId, moduleId])
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  password    String
  role        String       @default("STUDENT")
  cohort               String?
  cohortId             String?
  cohortRef            Cohort?   @relation(fields: [cohortId], references: [id])
  onboardedAt          DateTime?
  createdAt            DateTime     @default(now())
  certificateIssuedAt  DateTime?
  notionAccessToken    String?
  notionWorkspaceName  String?
  notionWorkspaceIcon  String?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  gmailRefreshToken    String?
  gmailEmail           String?
  gmailSyncedAt        DateTime?
  crmRole              String?   // ADMIN | MEMBER — only set for CRM users; null = LMS-only
  referralCode         String?   @unique
  submissions          Submission[]
  progress             Progress[]
  notes                Note[]
  coachingNotes        CoachingNote[]
  worksheetResponses   WorksheetResponse[]
  surveyResponses      SurveyResponse[]
  notifications        Notification[]
  supportTickets       SupportTicket[]
  passwordResetTokens  PasswordResetToken[]
  bridgeTokens         CrmBridgeToken[]
  attendanceRecords    AttendanceRecord[]
  crmLead              Lead?
  preworkSubmissions   PreworkSubmission[]
  oneOnOneSlots        OneOnOneSlot[]       @relation("AdminSlots")
  oneOnOneBookings     OneOnOneBooking[]    @relation("StudentBookings")
  discussionPosts      DiscussionPost[]
  discussionReplies    DiscussionReply[]
  discussionReactions  DiscussionReaction[]
  videoProgress        VideoProgress[]
  sectionComments      SectionComment[]
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  company     String?
  jobTitle    String?
  linkedinUrl String?

  // Pipeline
  stage       String   @default("LEAD")
  // LEAD | CONTACTED | APPLIED | STRATEGY_CALL | ADMITTED | OFFER_SENT | COMPLETED | ENROLLED | LOST

  source      String?
  // REFERRAL | LINKEDIN | WEBSITE | INSTAGRAM | COLD_EMAIL | EVENT | OTHER
  subSource   String?
  // For 3I_NEXTGEN source: MEMBER | NON_MEMBER_REFERRAL

  // UTM attribution — captured from landing page URL params
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  leadType    String?  @default("WAITLIST")
  // WAITLIST | APPLICATION | STUDENT | PARTNER | CONTACT

  lostReason    String?
  assignedTo    String?  // admin user email
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  paymentStatus String?  @default("UNPAID")
  // UNPAID | PAID_FULL | PAYMENT_PLAN | SCHOLARSHIP | OUTSTANDING
  dealValue   Int?     @default(0) // USD, whole dollars
  programType   String?  @default("STANDARD")
  // STANDARD | PAID_PILOT | PARTNER_COMPED
  cohortPartner String?  // "3i" | "Northwestern SPS" etc.
  tags        String[] @default([])
  notes       String?

  // Outcome tracking (post-graduation)
  outcomeStatus      String?   // PENDING | PLACED | STILL_SEARCHING | NOT_LOOKING
  outcomeCompany     String?
  outcomeRole        String?
  outcomeSalary      Int?      // annual USD, whole dollars
  outcomeStartDate   DateTime?
  outcomeNotes       String?
  outcomeUpdatedAt   DateTime?
  outcomeToken       String?   @unique // one-time token for the self-report form
  outcomeEmailSentAt DateTime?         // when we sent the follow-up email

  // Link to LMS user when converted to student
  enrolledUserId String? @unique
  enrolledUser   User?   @relation(fields: [enrolledUserId], references: [id])

  activities          LeadActivity[]
  tasks               Task[]
  sequenceEnrollments EmailSequenceEnrollment[]
  paymentRecords      PaymentRecord[]

  // Deals / Partnerships
  dealId          String?  // FK to Deal (participant in a deal)
  dealRef         Deal?    @relation("DealParticipants", fields: [dealId], references: [id])
  contactForDeals Deal[]   @relation("DealContact")

  promoCode    String?   // promo code applied at intake
  referralCode String?   // student referral code used at intake

  deletedAt    DateTime? // soft delete — null = active, non-null = in recycle bin
  unsubscribed Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([stage])
  @@index([deletedAt])
  @@index([deletedAt, updatedAt])
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String?
  discountPct Int?      // 0–100 percent off; null = tracking-only / access code
  maxUses     Int?      // null = unlimited
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  createdBy   String?
  assignedTo  String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([dueAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CRMNotification {
  id        String   @id @default(cuid())
  type      String   // TASK_OVERDUE | LEAD_ENROLLED | NEW_INTAKE | LEAD_COLD | SEQUENCE_SENT
  title     String
  body      String?
  leadId    String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model EmailSequence {
  id          String                    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  steps       EmailSequenceStep[]
  enrollments EmailSequenceEnrollment[]
}

model EmailSequenceStep {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber Int
  subject    String
  body       String
  delayDays  Int           @default(0)

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
}

model EmailSequenceEnrollment {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceId  String
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id])
  currentStep Int           @default(1)
  status      String        @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | CANCELLED
  nextSendAt  DateTime?
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  @@unique([leadId, sequenceId])
  @@index([status, nextSendAt])
}

model LeadActivity {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String    // NOTE | EMAIL | CALL | MEETING | STAGE_CHANGE | ENROLLED | CREATED
  content   String?
  subject   String?   // email subject line
  emailTo   String?   // recipient email address
  source    String?   // COMPOSER | SEQUENCE | GMAIL_SYNC | TEMPLATE | BLAST | UNSUBSCRIBE
  metadata  String?   // JSON — used for stage_change { from, to }
  createdBy String?   // admin user id
  openedAt  DateTime? // set when tracking pixel is loaded (email opens)
  createdAt DateTime  @default(now())

  @@index([leadId])
  @@index([type, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // FEEDBACK | APPROVED | NEEDS_REVISION | ANNOUNCEMENT
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Module {
  id          String       @id @default(cuid())
  number      Int          @unique
  title       String
  subtitle    String?
  description String?
  week        Int
  icon        String?
  unlocked    Boolean      @default(true)
  preworkDue      DateTime?
  sessionDate     DateTime?
  sessionLocation String?
  sessionZoomLink String?
  sections          Section[]
  submissions       Submission[]
  progress          Progress[]
  attendance        AttendanceRecord[]
  cohortSchedules   CohortSchedule[]
  preworkQuestions  PreworkQuestion[]
  preworkSubmissions PreworkSubmission[]
  oneOnOneSlots     OneOnOneSlot[]
  oneOnOneBookings  OneOnOneBooking[]
  discussionPosts   DiscussionPost[]
}

model Section {
  id            String           @id @default(cuid())
  moduleId      String
  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type          String
  title         String
  content       String?
  order         Int
  notionPageId  String?
  lastSyncedAt  DateTime?
  resources     Resource[]
  progress      Progress[]
  comments      SectionComment[]
}

model Resource {
  id        String          @id @default(cuid())
  sectionId String
  section   Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type      String
  title     String
  url       String?
  filePath  String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  videoProgress VideoProgress[]
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  title       String
  content     String?
  fileUrl     String?
  fileName    String?
  status          String   @default("PENDING")
  feedback        String?
  aiFeedback      String?
  aiReviewedAt    DateTime?
  studentReply    String?
  studentRepliedAt DateTime?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  sectionId   String?
  section     Section? @relation(fields: [sectionId], references: [id])
  completedAt DateTime @default(now())

  @@unique([userId, sectionId])
}

model WorksheetResponse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  worksheetId String
  rows        Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, moduleId, worksheetId])
}

model Announcement {
  id           String    @id @default(cuid())
  title        String
  body         String
  emoji        String    @default("📣")
  cohort       String?
  pinned       Boolean   @default(false)
  scheduledFor DateTime? // null = publish immediately
  emailsSentAt DateTime? // null = emails not yet sent
  createdAt    DateTime  @default(now())
  createdBy    String
}

model SurveyResponse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  answers     Json
  submittedAt DateTime @default(now())

  // Individual rating fields (populated alongside answers Json)
  overallRating      Int?
  contentRating      Int?
  facilitatorRating  Int?
  practicalRating    Int?
  wouldRecommend     Boolean?
  biggestTakeaway    String?
  improveSuggestion  String?
  additionalComments String?

  @@unique([userId, moduleId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  moduleId  String
  content   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model CrmBridgeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  targetUrl String    @default("/admin")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attended  Boolean  @default(false)
  note      String?
  markedAt  DateTime @default(now())

  @@unique([userId, moduleId])
}

model ReminderLog {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  type      String   // PREWORK | SESSION
  sentAt    DateTime @default(now())

  @@unique([userId, moduleId, type])
}

model SupportTicket {
  id                 String          @id @default(cuid())
  ticketNumber       Int             @unique @default(autoincrement())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject            String
  category           String          // TECHNICAL | CONTENT | COACHING | BILLING | OTHER
  description        String
  status             String          @default("OPEN") // OPEN | IN_PROGRESS | WAITING | RESOLVED | CLOSED
  priority           String          @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assigneeId         String?         // admin userId
  closedAt           DateTime?
  lastActivityAt     DateTime        @default(now())
  satisfactionRating Int?            // 1-5 after resolved
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  messages           TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorRole String        // STUDENT | ADMIN
  content    String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model CoachingNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  authorId  String   // admin user id who wrote it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Prework ──────────────────────────────────────────────────────────────────

model PreworkQuestion {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  question    String
  type        String   @default("textarea") // "text" | "textarea"
  placeholder String?
  required    Boolean  @default(true)
  createdAt   DateTime @default(now())
  answers     PreworkAnswer[]

  @@index([moduleId])
}

model PreworkSubmission {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submittedAt DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  answers     PreworkAnswer[]

  @@unique([userId, moduleId])
  @@index([moduleId])
  @@index([userId])
}

model PreworkAnswer {
  id           String            @id @default(cuid())
  submissionId String
  submission   PreworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     PreworkQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String

  @@unique([submissionId, questionId])
}

// ─── 1-on-1 Scheduling ───────────────────────────────────────────────────────

model OneOnOneSlot {
  id               String           @id @default(cuid())
  adminId          String
  admin            User             @relation("AdminSlots", fields: [adminId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime
  moduleId         String?
  module           Module?          @relation(fields: [moduleId], references: [id])
  isBooked         Boolean          @default(false)
  recurringGroupId String?
  createdAt        DateTime         @default(now())
  booking          OneOnOneBooking?

  @@index([startTime])
  @@index([adminId])
}

model OneOnOneBooking {
  id                 String       @id @default(cuid())
  slotId             String       @unique
  slot               OneOnOneSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentId          String
  student            User         @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  moduleId           String
  module             Module       @relation(fields: [moduleId], references: [id])
  status             String       @default("CONFIRMED") // CONFIRMED | CANCELLED
  preworkEmailSentAt DateTime?
  zoomMeetingId      String?
  zoomJoinUrl        String?
  zoomStartUrl       String?
  createdAt          DateTime     @default(now())

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
}

// ─── Community / Discussion ───────────────────────────────────────────────────

model DiscussionPost {
  id        String               @id @default(cuid())
  authorId  String
  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    Module?              @relation(fields: [moduleId], references: [id])
  content   String
  postType  String               @default("DISCUSSION")
  isPinned  Boolean              @default(false)
  isDeleted Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  replies   DiscussionReply[]
  reactions DiscussionReaction[]

  @@index([moduleId])
  @@index([authorId])
  @@index([createdAt])
}

model DiscussionReply {
  id        String         @id @default(cuid())
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  isAnswer  Boolean        @default(false)
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([postId])
}

model DiscussionReaction {
  id        String         @id @default(cuid())
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([postId, userId, emoji])
  @@index([postId])
}

// ─── Help Center ─────────────────────────────────────────────────────────────

model HelpArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  category  String   @default("GENERAL")
  published Boolean  @default(false)
  pinned    Boolean  @default(false)
  order     Int      @default(0)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, published])
}

// ─── Internal Course Issues ──────────────────────────────────────────────────


// ─── Payment Records ─────────────────────────────────────────────────────────

model PaymentRecord {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount    Int
  note      String?
  paidAt    DateTime @default(now())
  createdBy String?

  @@index([leadId])
}

// ─── Deals / Partnerships ─────────────────────────────────────────────────────

model Deal {
  id           String   @id @default(cuid())
  title        String   // e.g. "Northwestern SPS — Fall 2026"
  orgName      String   // university / firm name
  status       String   @default("PROSPECTING")
  // PROSPECTING | PROPOSAL_SENT | NEGOTIATING | SIGNED | ACTIVE | CLOSED_WON | CLOSED_LOST

  contactLeadId String?  // FK to Lead (a CONTACT type lead — the person at the org)
  contactLead   Lead?    @relation("DealContact", fields: [contactLeadId], references: [id])

  seats        Int?     // number of seats being sold
  pricePerSeat Int?     // USD, whole dollars
  totalValue   Int?     // USD — can override seats×price for flat-fee deals
  paymentType  String?  @default("ORG_INVOICE") // ORG_INVOICE | INDIVIDUAL | MIXED

  assignedTo   String?  // admin user email
  notes        String?
  proposalSentAt DateTime?
  signedAt     DateTime?
  startDate    DateTime?

  participants Lead[]   @relation("DealParticipants")
  activities   DealActivity[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type      String   // NOTE | EMAIL | CALL | MEETING | STATUS_CHANGE
  content   String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([dealId])
}

model VideoProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  moduleId        String
  percentWatched  Float    @default(0)
  watchedSeconds  Int      @default(0)
  durationSeconds Int?
  completedAt     DateTime?
  lastWatchedAt   DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
  @@index([moduleId])
}

model SectionComment {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  moduleId  String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  isPinned  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sectionId])
  @@index([moduleId])
}

model Event {
  id                  String              @id @default(cuid())
  slug                String              @unique
  title               String
  description         String?
  eventType           String              @default("IN_PERSON")  // IN_PERSON | ZOOM
  speakerName         String?
  speakerBio          String?
  speakerTitle        String?
  speakerImageUrl     String?
  location            String?
  venueAddress        String?
  meetingUrl          String?
  startsAt            DateTime
  endsAt              DateTime?
  timezone            String              @default("America/New_York")
  maxCapacity         Int?
  visibility          String              @default("PUBLIC")
  active              Boolean             @default(true)
  reminderSent7d      Boolean             @default(false)
  reminderSent24h     Boolean             @default(false)
  followUpSent        Boolean             @default(false)
  confirmationMessage String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  registrations       EventRegistration[]

  @@index([slug])
  @@index([startsAt])
  @@index([active, startsAt])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String
  phone        String?
  leadId       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  referralCode String?
  contactType  String   @default("STUDENT")  // STUDENT | PARENT
  attendedAt   DateTime?
  createdAt    DateTime @default(now())

  @@unique([eventId, email])
  @@index([eventId])
}

// ─── CRM Internal Issues ──────────────────────────────────────────────────────
// Separate from LMS student support tickets — used by Dan, David, and Caleb
// to track CRM data problems, ops flags, and feature requests.

model CrmIssue {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("BUG")      // BUG | DATA | OPS | FEATURE | OTHER
  status      String   @default("BACKLOG")  // BACKLOG | TODO | IN_PROGRESS | DONE
  priority    String   @default("NORMAL")   // LOW | NORMAL | HIGH | URGENT
  assignee    String?                        // CRM user email
  createdBy   String?                        // CRM user email
  tags        String[]
  linkedLeadId String?                       // optional link to a lead record
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([assignee])
}
