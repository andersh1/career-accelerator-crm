model WorksheetResponse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  worksheetId String
  rows        Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, moduleId, worksheetId])
}

model ModuleView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  sectionId String?
  viewedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, moduleId])
  @@index([userId])
}

/// One Hot Seat round: a cohort works through a module's spike statements out
/// loud while the rest of the room files feedback in real time. Dan's fix for
/// the engagement problem — nobody sits waiting for their turn.
model HotSeatSession {
  id        String    @id @default(cuid())
  cohortId  String
  cohort    Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  /// DRAFT (building the order) | OPEN (room is submitting) | CLOSED (feedback released)
  status    String    @default("DRAFT")
  createdBy String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  openedAt  DateTime? @db.Timestamptz(6)
  closedAt  DateTime? @db.Timestamptz(6)
  turns     HotSeatTurn[]
  feedback  HotSeatFeedback[]

  @@index([cohortId, moduleId])
}

/// A Fellow's slot in the running order. Set before the session so peers pick a
/// name instead of typing one mid-room; `absent` covers whoever didn't show.
model HotSeatTurn {
  id        String  @id @default(cuid())
  sessionId String
  session   HotSeatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Int
  absent    Boolean @default(false)
  /// The spike sentence as read to the room, captured so feedback stays legible later.
  spikeLine String?

  @@unique([sessionId, userId])
}

/// One peer's feedback on one Fellow's spike statement. `checks` holds the four
/// rubric keys (c3–c6) so the survey, the LMS rubric and the deck stay one thing.
/// Fellows read this anonymised; admins see the author.
model HotSeatFeedback {
  id            String   @id @default(cuid())
  sessionId     String
  session       HotSeatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjectUserId String
  subject       User     @relation("HotSeatSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  authorUserId  String
  author        User     @relation("HotSeatAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  checks        Json?
  comment       String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([sessionId, subjectUserId, authorUserId])
  @@index([subjectUserId])
}

/// Append-only record of what each Fellow actually did.
///
/// Backs the one-year guarantee: a refund decision cannot rest on live rows,
/// because those change. UPDATE and DELETE are refused by a database trigger,
/// and each row carries the hash of the row before it, so tampering is
/// detectable rather than merely discouraged. Corrections are new events.
model LedgerEvent {
  id             String   @id
  seq            BigInt   @unique @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohortId       String?
  moduleId       String?
  type           String
  occurredAt     DateTime @db.Timestamptz(6)
  recordedAt     DateTime @default(now()) @db.Timestamptz(6)
  source         String   @default("APP")
  detail         Json?
  idempotencyKey String   @unique
  prevHash       String?
  hash           String

  @@index([userId])
  @@index([cohortId, type])
}

/// An admin's attestation that something happened outside the app — Dan books a
/// 1-on-1 over his own Calendly link, a Fellow emails their pre-work. Kept apart
/// from the real rows so a manual mark is never mistaken for the thing itself,
/// and mirrored into the append-only LedgerEvent so the guarantee record shows
/// who asserted what, and when.
model ManualSignal {
  id           String   @id
  userId       String
  user         User     @relation("ManualSignalSubject", fields: [userId], references: [id], onDelete: Cascade)
  cohortId     String?
  /// "" means the signal is cohort-wide, not tied to a module. A sentinel, not
  /// NULL: Postgres treats NULLs as distinct, so a nullable column here would
  /// let the unique index admit duplicate cohort-wide marks.
  moduleId     String   @default("")
  type         String
  occurredAt   DateTime @default(now()) @db.Timestamptz(6)
  note         String?
  recordedById String
  recordedBy   User     @relation("ManualSignalRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, moduleId, type])
  @@index([cohortId, type])
}

/// The Notion database a Fellow owns for one worksheet.
///
/// Each export writes into the SAME database rather than making another page,
/// so a tracker accumulates across the program instead of scattering into a
/// dozen snapshots. The database lives in the Fellow's own workspace, created
/// with their own token — we only remember its id so the next export can find
/// it again. Nothing here survives them deleting it on their side, and nothing
/// here gives us access after they disconnect.
model NotionExport {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  worksheetId String
  databaseId  String
  url         String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, moduleId, worksheetId])
}

/// A partner organisation — 3i, SCS, PwC, a university.
///
/// Added 11 Sept after the call with Dan and David. Before this, a deal carried
/// the org as a free-text `orgName`, so "3i" and "3i NextGen" were unrelated
/// strings and there was no way to see everyone at one institution together.
///
/// David: "the organization has multiple contact people, and then underneath
/// that organization, we're working on specific deals with them." A deal can be
/// seats, or it can simply be an event — a lunch and learn with an RIA is a
/// deal — and a deal can carry the promo code that represents it.
///
/// A one-person RIA will have an Organization and a Lead with the same name.
/// That is expected: one is a company, the other is a person.
model Organization {
  id          String   @id @default(cuid())
  name        String
  /// UNIVERSITY | EMPLOYER | RIA | MEMBERSHIP | AGENCY | OTHER
  type        String   @default("OTHER")
  website     String?
  notes       String?
  assignedTo  String?
  createdBy   String?
  contacts    Lead[]        @relation("OrgContacts")
  deals       Deal[]
  events      Event[]
  promoCodes  PromoCode[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

/// One cohort's override of an automated email.
///
/// A delta, not a copy: every field is nullable and null means "inherit the
/// shared EmailTemplate". So a cohort can change only the subject, or only
/// switch the email off, without taking a snapshot of copy that then stops
/// tracking edits to the shared version.
///
/// This exists because the copy AND the on/off switch used to be shared by
/// every cohort at once. module-preamble-1 carried one cohort's dates and
/// its Demo Day, which is wrong for a private 1:1 client running the same
/// module on their own schedule.
model CohortEmailTemplate {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  /// Matches EmailTemplate.key, e.g. "module-preamble-1".
  key       String
  subject   String?
  body      String?
  enabled   Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([cohortId, key])
  @@index([cohortId])
}

/// A named, versioned package of module content that cohorts enrol into.
///
/// The point is that many cohorts share one version. A per-cohort copy would
/// mean ten cohorts on the same content are ten rows, and fixing a typo is ten
/// edits; here it is one. Launching a cohort is then "pick a version", and a
/// cohort already running keeps the version it started on however much the
/// next one is rewritten.
///
/// `parentId` is how the paths work without multiplying everything. "Private
/// 1:1" has "Core" as its parent and stores only the modules that genuinely
/// differ; everything else resolves up the chain. A university or age-specific
/// path is another child, not another copy of all eight modules.
model ContentVersion {
  id        String   @id @default(cuid())
  /// What Caleb calls it when picking one: "Core v1", "Fall 2026", "Private 1:1".
  name      String
  /// COHORT | PRIVATE | UNIVERSITY | ... free-form so a new path needs no migration.
  track     String   @default("COHORT")
  /// Inherit anything this version does not define. Null is a root version.
  parentId  String?
  parent    ContentVersion?  @relation("VersionLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children  ContentVersion[] @relation("VersionLineage")
  /// DRAFT | PUBLISHED | ARCHIVED. Only PUBLISHED should be offered when
  /// launching a cohort; DRAFT is where a rewrite lives while it is half done.
  status    String   @default("DRAFT")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  modules   ModuleContent[]
  cohorts   Cohort[]
}

/// One module's content, for one version.
///
/// `data` is the JSON of the same structure the code exports, verified
/// byte-identical when it was snapshotted. Resolution is: the cohort's version,
/// then up its parent chain, then the code constant. A cohort with no version,
/// or a version with no row for this module, behaves exactly as it always has.
/// See src/lib/module-content.ts.
model ModuleContent {
  id           String   @id @default(cuid())
  versionId    String?
  version      ContentVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  moduleNumber Int
  /// worksheets | overview | assignment | survey | slides
  kind         String
  data         Json
  /// Why this version of this module exists, for whoever finds it in a year.
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([versionId, moduleNumber, kind])
  @@index([versionId])
}

