  @@unique([userId, moduleId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // FEEDBACK | APPROVED | NEEDS_REVISION | ANNOUNCEMENT
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, type, createdAt])
}

model OneOnOneBooking {
  id                 String       @id @default(cuid())
  slotId             String       @unique
  slot               OneOnOneSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentId          String
  student            User         @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  moduleId           String
  module             Module       @relation(fields: [moduleId], references: [id])
  status             String       @default("CONFIRMED") // CONFIRMED | CANCELLED
  preworkEmailSentAt DateTime?
  zoomMeetingId      String?      // Zoom meeting ID
  zoomJoinUrl        String?      // student join link
  zoomStartUrl       String?      // host start link (Dan's link)
  calendlyEventUri   String?      @unique // Calendly scheduled_event URI when booked via Calendly
  createdAt          DateTime     @default(now())

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
}

model OneOnOneSlot {
  id               String           @id @default(cuid())
  adminId          String
  admin            User             @relation("AdminSlots", fields: [adminId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime
  moduleId         String?
  module           Module?          @relation(fields: [moduleId], references: [id])
  isBooked         Boolean          @default(false)
  recurringGroupId String?
  createdAt        DateTime         @default(now())
  booking          OneOnOneBooking?

  @@index([startTime])
  @@index([adminId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model PaymentRecord {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Whole dollars. Every screen already reads this, so it keeps its meaning.
  amount    Int
  /// The exact figure in cents, as the processor reported it. Rounding each
  /// instalment of a split tuition to whole dollars loses cents the total can
  /// never get back, so a synced row carries the true number here and the
  /// revenue and analytics roll-ups prefer it. Null on a hand-entered row.
  amountCents Int?
  /// MANUAL (or null) for a payment someone typed in, IGNITION for one a
  /// webhook wrote. Worth knowing before anyone edits or deletes a row.
  source    String?
  /// The external invoice this row settles — the Ignition invoice slug. Unique,
  /// because Ignition says outright that deliveries repeat and arrive out of
  /// order: a second delivery has to update this row, not bank the money twice.
  externalId String? @unique
  note      String?
  paidAt    DateTime @default(now())
  createdBy String?

  @@index([leadId])
}

model PreworkAnswer {
  id           String            @id @default(cuid())
  submissionId String
  submission   PreworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     PreworkQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String

  @@unique([submissionId, questionId])
}

model PreworkNote {
  id         String   @id @default(cuid())
  userId     String   // student
  moduleId   String
  sectionKey String   // "general" | "session-questions" | "answer:<questionId>" | "worksheet:<worksheetId>"
  content    String
  authorId   String   // admin who wrote it
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation("PreworkNoteUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, moduleId, sectionKey])
}

model PreworkQuestion {
