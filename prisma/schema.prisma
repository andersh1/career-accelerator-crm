  email       String       @unique
  name        String
  password    String
  role        String       @default("STUDENT")
  cohort               String?
  cohortId             String?
  cohortRef            Cohort?   @relation(fields: [cohortId], references: [id])
  onboardedAt          DateTime?
  xpPoints             Int          @default(0)
  createdAt            DateTime     @default(now())
  certificateIssuedAt  DateTime?
  notionAccessToken    String?
  notionWorkspaceName  String?
  notionWorkspaceIcon  String?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  timezone             String    @default("America/New_York")
  crmRole              String?   // ADMIN | MEMBER — CRM access role; null = LMS-only student
  calendlyUrl          String?   // coach Calendly scheduling link (admins only)
  officeHoursUrl       String?   // office-hours Calendly link (admins only) — quick-help bookings
  mcpToken             String?   @unique // personal access token for the Claude MCP connector
  threeSixtyToken      String?   @unique // public 360-ask link token
  calendarToken        String?   @unique // self-authenticating calendar subscription feed
  invitedAt            DateTime? @db.Timestamptz(6) // invite email sent; distinct from onboardedAt
  /// Set when a Fellow leaves the program. Never delete the account: the
  /// submissions, worksheets, attendance and coach notes are the record of
  /// what they completed, and a refund conversation needs them. This flag
  /// blocks login and drops them from every cron, count and report instead.
  withdrawnAt          DateTime?
  withdrawnReason      String?
  /// Per-person UI preferences that should follow the account, not the browser.
  uiPrefs              Json?
  threeSixtyResponses  ThreeSixtyResponse[]
  gmailRefreshToken    String?
  gmailEmail           String?
  gmailSyncedAt        DateTime?
  submissions          Submission[]
  progress             Progress[]
  notes                Note[]
  coachingNotes        CoachingNote[]
  worksheetResponses   WorksheetResponse[]
  surveyResponses      SurveyResponse[]
  growthBatteries      GrowthBattery[]
  weeklyCheckins       WeeklyCheckin[]
  oneOnOnePulses       OneOnOnePulse[]
  interventionFlags    InterventionFlag[]
  notifications        Notification[]
  hotSeatTurns         HotSeatTurn[]
  hotSeatReceived      HotSeatFeedback[]    @relation("HotSeatSubject")
  hotSeatGiven         HotSeatFeedback[]    @relation("HotSeatAuthor")
  supportTickets       SupportTicket[]
  passwordResetTokens  PasswordResetToken[]
  bridgeTokens         CrmBridgeToken[]
  attendanceRecords    AttendanceRecord[]
  crmLead              Lead?
  preworkSubmissions   PreworkSubmission[]
  oneOnOneSlots        OneOnOneSlot[]       @relation("AdminSlots")
  oneOnOneBookings     OneOnOneBooking[]    @relation("StudentBookings")
  discussionPosts      DiscussionPost[]
  discussionReplies    DiscussionReply[]
  discussionReactions  DiscussionReaction[]
  videoProgress        VideoProgress[]
  sectionComments      SectionComment[]
  sentMessages         DirectMessage[]  @relation("SentMessages")
  receivedMessages     DirectMessage[]  @relation("ReceivedMessages")
  jobApplications      JobApplication[]
  loginStreaks         LoginStreak[]
  moduleViews          ModuleView[]
  ledgerEvents         LedgerEvent[]
  notionExports        NotionExport[]
  manualSignals        ManualSignal[]  @relation("ManualSignalSubject")
  manualSignalsRecorded ManualSignal[] @relation("ManualSignalRecorder")
  referralCode         String?   @unique

  preworkNotesAbout PreworkNote[] @relation("PreworkNoteUser")
}

model VideoProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
