generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHARED DATABASE — READ BEFORE MIGRATING
// The LMS and CRM apps BOTH point at the same Neon Postgres database (neondb).
// This schema is the FULL model set for that database and is kept identical
// (models only) in both repos:
//   Career Accelerator LMS/prisma/schema.prisma
//   Career Accelerator CRM/prisma/schema.prisma
// When you change a model here, make the same change in the other repo's schema.
// Never run `prisma db push --accept-data-loss`. Before any push, run:
//   npx prisma migrate diff --from-url "$POSTGRES_URL_NON_POOLING" \
//     --to-schema-datamodel prisma/schema.prisma --script
// and read the SQL it prints.
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id           String    @id @default(cuid())
  title        String
  body         String
  emoji        String    @default("📣")
  /// DEPRECATED targeting by the cohort's free-text NAME. Renaming a
  /// cohort silently broke it. Kept so old rows still resolve; new
  /// ones set cohortId instead.
  cohort       String?
  /// Who it is for. Null means every cohort.
  cohortId     String?
  /// An admin-only record rather than something to tell Fellows. The
  /// email blast logs itself here so its history sits with the other
  /// announcements for admins, but a Fellow must never see
  /// "Sent to 47 recipients. Filters: {...}" on their dashboard.
  internal     Boolean   @default(false)
  cohortRef    Cohort?   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  pinned       Boolean   @default(false)
  scheduledFor DateTime? // null = publish immediately
  emailsSentAt DateTime? // null = emails not yet sent
  createdAt    DateTime  @default(now())
  createdBy    String
  @@index([cohortId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attended  Boolean  @default(false)
  note      String?
  markedAt  DateTime @default(now())

  @@unique([userId, moduleId])
}

model CRMNotification {
  id        String   @id @default(cuid())
  type      String   // TASK_OVERDUE | LEAD_ENROLLED | NEW_INTAKE | LEAD_COLD | SEQUENCE_SENT | PAYMENT_RECEIVED
  title     String
  body      String?
  leadId    String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model CoachingNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  authorId  String   // admin user id who wrote it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cohort {
  id        String           @id @default(cuid())
  name      String
  isActive  Boolean          @default(true)
  /// COHORT | PRIVATE — mirrored from the LMS schema, which owns this field.
  /// PRIVATE is a single paying 1:1 client running the modules on their own
  /// schedule. In the CRM it matters mainly for reporting: a one-person cohort
  /// makes completion rates and health scores meaningless, so private cohorts
  /// should be excluded from cohort averages rather than folded into them.
  track     String           @default("COHORT")
  founderMode Boolean        @default(false)
  orientationDate         DateTime? @db.Timestamptz(6)
  orientationZoomLink     String?
  orientationDeckUrl      String?
  orientationRecordingUrl String?
  /// Stamped when the pre-orientation email is sent, so a second press cannot
  /// mail the cohort twice. Cleared by hand if it genuinely needs resending.
  orientationEmailSentAt DateTime? @db.Timestamptz(6)
  capacity  Int?
  startDate DateTime? @db.Timestamptz(6)
  createdAt DateTime         @default(now())
  users     User[]
  schedules CohortSchedule[]
  hotSeatSessions HotSeatSession[]
  liveSessions    LiveSession[]
  publishedAt          DateTime? @db.Timestamptz(6) // when the cohort was published to the LMS
  invitesSent          Int       @default(0) // invite emails sent by that publish
  /// This cohort's own Slack invite. Null falls back to the shared
  /// slack_invite_url AppSetting, which is how every cohort behaved
  /// before. A private 1:1 client should not be invited into the
  /// group cohort's workspace.
  slackInviteUrl  String?
  resources       Resource[]
  announcements   Announcement[]
  emailOverrides  CohortEmailTemplate[]
  /// Which content package this cohort is running. Null means the code
  /// constants, which is how every cohort behaved before versions existed.
  contentVersionId String?
  contentVersion   ContentVersion? @relation(fields: [contentVersionId], references: [id], onDelete: SetNull)
  programTools    ProgramTool[]
}

/// A live group session that is NOT one of the eight modules — the Claude build
/// sessions, the Thursday drop-ins, the Module 7 finish clinic.
///
/// Deliberately its own model rather than a ninth Module: modules are gated by
/// start date and the previous survey, counted in "Week N of 8" and the progress
/// ring, and Cohort Pulse picks "the module still owed work" from them. A session
/// added to that list would quietly wrong-foot all four.
///
/// cohortId null means every cohort sees it, so a standing series doesn't have to
/// be re-created per cohort.
model LiveSession {
  id           String    @id @default(cuid())
  cohortId     String?
  cohort       Cohort?   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  title        String
  /// BUILD | OFFICE_HOURS | CLINIC — drives the badge and nothing else.
  kind         String    @default("BUILD")
  /// One line on the index page.
  summary      String?
  /// Markdown body: what it's for, what to bring, what you leave with.
  description  String?
  startsAt     DateTime? @db.Timestamptz(6)
  durationMins Int?
  zoomLink     String?
  /// Fellows only see published sessions; drafts stay admin-side.
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resources    LiveSessionResource[]

  @@index([cohortId])
  @@index([startsAt])
}

model LiveSessionResource {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// VIDEO | LINK | PPTX | FILE — VIDEO is what the player renders.
  type      String      @default("LINK")
  title     String
  url       String
  order     Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model CohortSchedule {
  id              String   @id @default(cuid())
  cohortId        String
  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  startDate       DateTime?
  preworkDue      DateTime?
  /// When the module's assignment is due — the Friday after the session. The
  /// programme ran for two weeks with this deadline living only in Slack, so
  /// nothing could count who had missed it.
  assignmentDue   DateTime?
  sessionDate     DateTime?
  sessionLocation String?
  sessionZoomLink String?
  /// When this module's kick-off email goes out. Null = not scheduled.
  preambleDate    DateTime? @db.Timestamptz(6)
  /// Stamped once sent, so a re-run cannot mail the cohort twice.
  preambleSentAt  DateTime? @db.Timestamptz(6)

  /// Deliberately not sending this cohort this module's kick-off.
  ///
  /// Clearing preambleDate has the same effect on the cron, but a blank date
  /// cannot tell "we chose to skip this" apart from "nobody set it yet" — so
  /// the readiness check has to warn about both, and a real missed kick-off
  /// hides among the intentional ones. This records the intent, and keeps the
  /// date so un-skipping does not mean retyping it.
  ///
  /// Only affects the automated cron. The manual "send kick-off now" button is
  /// an explicit human act and still sends.
  preambleSkipped Boolean @default(false)

  /// When this cohort calls a module something else. Module titles are global
  /// — Module.number is unique and Section has no cohort — so this is the one
  /// per-cohort override. A private client has no Demo Day, so Module 8 is
  /// "Accelerator Recap and Where We Go From Here" for them and "Personal
  /// Board" for everyone else. Null means use Module.title.
  titleOverride   String?

  @@unique([cohortId, moduleId])
}

model CrmBridgeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  targetUrl String    @default("/admin")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model CrmIssue {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  description String?
  type        String   @default("BUG")      // BUG | DATA | OPS | FEATURE | OTHER
  status      String   @default("BACKLOG")  // BACKLOG | TODO | IN_PROGRESS | DONE
  priority    String   @default("NORMAL")   // LOW | NORMAL | HIGH | URGENT
  assignee    String?                        // CRM user email
  createdBy   String?                        // CRM user email
  tags        String[] @default([])
  linkedLeadId String?                       // optional link to a lead record
  /// When it needs doing. Null = no date, which is fine for a backlog item.
  dueAt       DateTime?
  /// Who wants to hear about progress — emails. Recorded and shown on the card;
  /// nothing is sent yet. Notifying before the board is part of the routine is
  /// how you get a noisy tool nobody opens.
  notify      String[] @default([])
  /// Where it came from, e.g. "Team call 2026-09-10". Work piles up from several
  /// calls a week and "which conversation was this?" is the first thing you ask.
  source      String?
  /// Set when it moves to DONE. createdAt is when it landed, dueAt is when it
  /// was wanted, closedAt is when it actually finished — the three you need to
  /// see whether things are getting done or just getting added.
  /// What we actually did, written when it closes. The board answers "is it
  /// done"; this answers "what changed", which is the thing you need weeks
  /// later when the same question comes back.
  resolution  String?
  resolvedBy  String?
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([assignee])
}

model Deal {
  id           String   @id @default(cuid())
  title        String   // e.g. "Northwestern SPS — Fall 2026"
  orgName      String   // legacy free-text; Organization is the real link now
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// SEATS | EVENT | PARTNERSHIP — an event (a lunch and learn) is a deal too.
  dealType     String   @default("SEATS")
  promoCodeId  String?
  promoCode    PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  status       String   @default("PROSPECTING")
  // PROSPECTING | PROPOSAL_SENT | NEGOTIATING | SIGNED | ACTIVE | CLOSED_WON | CLOSED_LOST

  contactLeadId String?  // FK to Lead (a CONTACT type lead — the person at the org)
  contactLead   Lead?    @relation("DealContact", fields: [contactLeadId], references: [id])

  seats        Int?     // number of seats being sold
  pricePerSeat Int?     // USD, whole dollars
  totalValue   Int?     // USD — can override seats×price for flat-fee deals
  paymentType  String?  @default("ORG_INVOICE") // ORG_INVOICE | INDIVIDUAL | MIXED

  assignedTo   String?  // admin user email
  notes        String?
  proposalSentAt DateTime?
  signedAt     DateTime?
  startDate    DateTime?

  participants Lead[]   @relation("DealParticipants")
  activities   DealActivity[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type      String   // NOTE | EMAIL | CALL | MEETING | STATUS_CHANGE
  content   String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([dealId])
}

model DirectMessage {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("SentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("ReceivedMessages", fields: [toId], references: [id], onDelete: Cascade)
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fromId])
  @@index([toId])
  @@index([fromId, toId])
}

model DiscussionPost {
  id        String               @id @default(cuid())
  authorId  String
  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    Module?              @relation(fields: [moduleId], references: [id])
  content   String
  postType  String               @default("DISCUSSION")
  isPinned  Boolean              @default(false)
  isDeleted Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  replies   DiscussionReply[]
  reactions DiscussionReaction[]

  @@index([moduleId])
  @@index([authorId])
  @@index([createdAt])
}

model DiscussionReaction {
  id        String         @id @default(cuid())
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model DiscussionReply {
  id        String         @id @default(cuid())
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  isAnswer  Boolean        @default(false)
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([postId])
}

model EmailSequence {
  id          String                    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  steps       EmailSequenceStep[]
  enrollments EmailSequenceEnrollment[]
}

model EmailSequenceEnrollment {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceId  String
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id])
  currentStep Int           @default(1)
  status      String        @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | CANCELLED
  nextSendAt  DateTime?
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  @@unique([leadId, sequenceId])
  @@index([status, nextSendAt])
}

model EmailSequenceStep {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber Int
  subject    String
  body       String
  delayDays  Int           @default(0)

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
}

model EmailTemplate {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  subject      String
  body         String
  placeholders String   @default("")
  enabled      Boolean  @default(true)
  editable     Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt
  updatedBy    String?
}

model Event {
  id                  String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId      String?
  organization        Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  slug                String              @unique
  title               String
  description         String?
  eventType           String              @default("IN_PERSON")  // IN_PERSON | ZOOM
  speakerName         String?
  speakerBio          String?
  speakerTitle        String?
  speakerImageUrl     String?
  location            String?
  venueAddress        String?
  meetingUrl          String?
  startsAt            DateTime @db.Timestamptz(6)
  endsAt              DateTime? @db.Timestamptz(6)
  timezone            String              @default("America/New_York")
  maxCapacity         Int?
  visibility          String              @default("PUBLIC")
  active              Boolean             @default(true)
  reminderSent7d      Boolean             @default(false)
  reminderSent24h     Boolean             @default(false)
  followUpSent        Boolean             @default(false)
  confirmationMessage String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  registrations       EventRegistration[]

  @@index([slug])
  @@index([startsAt])
  @@index([active, startsAt])
}

model EventRegistration {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firstName    String
  lastName     String
  email        String
  phone        String?
  leadId       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  referralCode String?
  contactType  String   @default("STUDENT")  // STUDENT | PARENT
  attendedAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([eventId, email])
  @@index([eventId])
}

model HelpArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  category  String   @default("GENERAL")
  published Boolean  @default(false)
  pinned    Boolean  @default(false)
  order     Int      @default(0)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, published])
}

model JobApplication {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  role      String
  url       String?
  // WISHLIST | APPLIED | PHONE_SCREEN | INTERVIEW | FINAL_ROUND | OFFER | REJECTED | WITHDRAWN
  status    String    @default("WISHLIST")
  source    String?   // LINKEDIN | REFERRAL | COLD_EMAIL | JOB_BOARD | COMPANY_SITE | EVENT | OTHER
  salary    String?
  location  String?
  notes     String?
  appliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  company     String?
  jobTitle    String?
  linkedinUrl String?

  // Pipeline
  stage       String   @default("LEAD")
  // LEAD | CONTACTED | APPLIED | STRATEGY_CALL | ADMITTED | OFFER_SENT | COMPLETED | ENROLLED | LOST

  source      String?
  // REFERRAL | LINKEDIN | WEBSITE | INSTAGRAM | COLD_EMAIL | EVENT | OTHER
  subSource   String?
  // For 3I_NEXTGEN source: MEMBER | NON_MEMBER_REFERRAL

  // UTM attribution — captured from landing page URL params
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  // Year of study, e.g. "Senior" or "Recent graduate". A real column rather
  // than a line inside `notes`, so it can actually be filtered and exported —
  // "how many recent grads applied" is a question worth being able to ask.
  /// Where they study or studied. Dan asks it on every call anyway; capturing
  /// it at intake means he is not opening the conversation with admin.
  school       String?

  academicYear String?

  // Which landing page they arrived on, e.g. "/frankel" or "/scarsdale".
  // Custom landing pages are handed out as bare URLs (a counsellor's referral,
  // a printed card), so there are no utm_* params to read — the path is the
  // only attribution we get. First touch wins.
  landingPage String?

  leadType    String?  @default("WAITLIST")
  // WAITLIST | APPLICATION | STUDENT | PARTNER | CONTACT

  // Who filled out the form — parents increasingly submit on behalf of students
  personaRole String?  // PARENT | STUDENT

  // Home ZIP (the student's family home) + geo appended server-side from ZIP
  zip         String?
  city        String?
  state       String?

  // Student contact info when a PARENT submitted the form
  studentFirstName String?
  studentLastName  String?
  studentEmail     String?
  studentPhone     String?

  /// Why a deal ended, split in two because they are different events: a LOST
  /// deal is one the family walked away from, a DECLINED one is a person we
  /// turned down. Category is a fixed list so the "why we lose" chart stays
  /// countable; lostReason keeps the free-text detail behind it.
  lostCategory  String?
  lostReason    String?
  assignedTo    String?  // admin user email
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  paymentStatus String?  @default("UNPAID")
  // UNPAID | PAID_FULL | PAYMENT_PLAN | SCHOLARSHIP | OUTSTANDING
  dealValue   Int?     @default(0) // USD, whole dollars
  programType   String?  @default("STANDARD")
  // STANDARD | PAID_PILOT | PARTNER_COMPED
  cohortPartner String?  // "3i" | "Northwestern SPS" etc.
  tags        String[] @default([])
  notes       String?

  // Outcome tracking (post-graduation)
  outcomeStatus      String?   // PENDING | PLACED | STILL_SEARCHING | NOT_LOOKING
  outcomeCompany     String?
  outcomeRole        String?
  outcomeSalary      Int?      // annual USD, whole dollars
  outcomeStartDate   DateTime?
  outcomeNotes       String?
  outcomeUpdatedAt   DateTime?
  outcomeToken       String?   @unique // one-time token for the self-report form
  outcomeEmailSentAt DateTime?         // when we sent the follow-up email

  // Link to LMS user when converted to student
  organizationId String?
  organization   Organization? @relation("OrgContacts", fields: [organizationId], references: [id], onDelete: SetNull)
  enrolledUserId String? @unique
  enrolledUser   User?   @relation(fields: [enrolledUserId], references: [id])

  activities          LeadActivity[]
  tasks               Task[]
  sequenceEnrollments EmailSequenceEnrollment[]
  paymentRecords      PaymentRecord[]

  // Deals / Partnerships
  dealId          String?  // FK to Deal (participant in a deal)
  dealRef         Deal?    @relation("DealParticipants", fields: [dealId], references: [id])
  contactForDeals Deal[]   @relation("DealContact")

  promoCode    String?   // promo code applied at intake
  referralCode String?   // student referral code used at intake

  deletedAt    DateTime? // soft delete — null = active, non-null = in recycle bin
  unsubscribed Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([stage])
  @@index([deletedAt])
  @@index([deletedAt, updatedAt])
}

model LeadActivity {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String    // NOTE | EMAIL | CALL | MEETING | STAGE_CHANGE | ENROLLED | CREATED
  content   String?
  subject   String?   // email subject line
  emailTo   String?   // recipient email address
  source    String?   // COMPOSER | SEQUENCE | GMAIL_SYNC | TEMPLATE | BLAST | UNSUBSCRIBE | IGNITION
  metadata  String?   // JSON — used for stage_change { from, to }
  createdBy String?   // admin user id
  openedAt  DateTime? // set when tracking pixel is loaded (email opens)
  /// Which module this belongs to, so the lead record can be read a module at a
  /// time instead of as one long undifferentiated timeline. Null = not
  /// module-scoped (consultations, stage changes, general coaching notes).
  moduleNumber Int?
  /// INTERNAL  — anything the team logs or the student did; safe to discuss.
  /// PRIVATE   — coach-only notes. Never shown to the student and never quoted
  ///             back to them; surfaced separately in the CRM so it cannot be
  ///             mistaken for something they have already seen.
  visibility String   @default("INTERNAL")
  createdAt DateTime  @default(now())

  @@index([leadId])
  @@index([type, createdAt])
  @@index([leadId, moduleNumber])
}

model LoginStreak {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int    @default(0)
  longestStreak Int    @default(0)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId])
  @@index([userId])
}

model Module {
  id          String       @id @default(cuid())
  number      Int          @unique
  title       String
  subtitle    String?
  description String?
  week        Int
  icon        String?
  unlocked    Boolean      @default(true)
  startDate       DateTime?
  preworkDue      DateTime?
  sessionDate     DateTime?
  sessionLocation String?
  sessionZoomLink String?
  sections          Section[]
  submissions       Submission[]
  progress          Progress[]
  attendance        AttendanceRecord[]
  cohortSchedules   CohortSchedule[]
  preworkQuestions  PreworkQuestion[]
  preworkSubmissions PreworkSubmission[]
