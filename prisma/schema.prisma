model Submission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  title       String
  content     String?
  fileUrl     String?
  fileName    String?
  status          String   @default("PENDING")
  feedback        String?
  aiFeedback      String?
  aiReviewedAt    DateTime?
  studentReply    String?
  studentRepliedAt DateTime?
  /// The content as it stood before the most recent revision, so a coach can
  /// see what actually changed instead of re-reading the whole thing.
  previousContent String?
  revisionCount   Int      @default(0)
  revisedAt       DateTime?
  feedbackHistory SubmissionFeedback[]
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
}

/// One round of coach feedback on a submission.
///
/// `Submission.feedback` holds only the latest round, so writing round two
/// erased round one — the request the Fellow was actually answering. Each send
/// is appended here instead, and the whole conversation stays readable.
model SubmissionFeedback {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  round        Int
  content      String
  status       String
  authorId     String?
  sentAt       DateTime   @default(now())

  @@unique([submissionId, round])
  @@index([submissionId])
}

model SupportTicket {
