generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHARED DATABASE — READ BEFORE MIGRATING
// The LMS and CRM apps BOTH point at the same Neon Postgres database (neondb).
// This schema is the FULL model set for that database and is kept identical
// (models only) in both repos:
//   Career Accelerator LMS/prisma/schema.prisma
//   Career Accelerator CRM/prisma/schema.prisma
// When you change a model here, make the same change in the other repo's schema.
// Never run `prisma db push --accept-data-loss`. Before any push, run:
//   npx prisma migrate diff --from-url "$POSTGRES_URL_NON_POOLING" \
//     --to-schema-datamodel prisma/schema.prisma --script
// and read the SQL it prints.
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id           String    @id @default(cuid())
  title        String
  body         String
  emoji        String    @default("📣")
  cohort       String?
  pinned       Boolean   @default(false)
  scheduledFor DateTime? // null = publish immediately
  emailsSentAt DateTime? // null = emails not yet sent
  createdAt    DateTime  @default(now())
  createdBy    String
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attended  Boolean  @default(false)
  note      String?
  markedAt  DateTime @default(now())

  @@unique([userId, moduleId])
}

model CRMNotification {
  id        String   @id @default(cuid())
  type      String   // TASK_OVERDUE | LEAD_ENROLLED | NEW_INTAKE | LEAD_COLD | SEQUENCE_SENT
  title     String
  body      String?
  leadId    String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model CoachingNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  authorId  String   // admin user id who wrote it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cohort {
  id        String           @id @default(cuid())
  name      String
  isActive  Boolean          @default(true)
  founderMode Boolean        @default(false)
  orientationDate         DateTime? @db.Timestamptz(6)
  orientationZoomLink     String?
  orientationDeckUrl      String?
  orientationRecordingUrl String?
  capacity  Int?
  startDate DateTime? @db.Timestamptz(6)
  createdAt DateTime         @default(now())
  users     User[]
  schedules CohortSchedule[]
  hotSeatSessions HotSeatSession[]
  publishedAt          DateTime? @db.Timestamptz(6) // when the cohort was published to the LMS
  invitesSent          Int       @default(0) // invite emails sent by that publish
}

model CohortSchedule {
  id              String   @id @default(cuid())
  cohortId        String
  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  startDate       DateTime?
  preworkDue      DateTime?
  sessionDate     DateTime?
  sessionLocation String?
  sessionZoomLink String?
  /// When this module's kick-off email goes out. Null = not scheduled.
  preambleDate    DateTime? @db.Timestamptz(6)
  /// Stamped once sent, so a re-run cannot mail the cohort twice.
  preambleSentAt  DateTime? @db.Timestamptz(6)

  @@unique([cohortId, moduleId])
}

model CrmBridgeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  targetUrl String    @default("/admin")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model CrmIssue {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  description String?
  type        String   @default("BUG")      // BUG | DATA | OPS | FEATURE | OTHER
  status      String   @default("BACKLOG")  // BACKLOG | TODO | IN_PROGRESS | DONE
  priority    String   @default("NORMAL")   // LOW | NORMAL | HIGH | URGENT
  assignee    String?                        // CRM user email
  createdBy   String?                        // CRM user email
  tags        String[] @default([])
  linkedLeadId String?                       // optional link to a lead record
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([assignee])
}

model Deal {
  id           String   @id @default(cuid())
  title        String   // e.g. "Northwestern SPS — Fall 2026"
  orgName      String   // university / firm name
  status       String   @default("PROSPECTING")
  // PROSPECTING | PROPOSAL_SENT | NEGOTIATING | SIGNED | ACTIVE | CLOSED_WON | CLOSED_LOST

  contactLeadId String?  // FK to Lead (a CONTACT type lead — the person at the org)
  contactLead   Lead?    @relation("DealContact", fields: [contactLeadId], references: [id])

  seats        Int?     // number of seats being sold
  pricePerSeat Int?     // USD, whole dollars
  totalValue   Int?     // USD — can override seats×price for flat-fee deals
  paymentType  String?  @default("ORG_INVOICE") // ORG_INVOICE | INDIVIDUAL | MIXED

  assignedTo   String?  // admin user email
  notes        String?
  proposalSentAt DateTime?
  signedAt     DateTime?
  startDate    DateTime?

  participants Lead[]   @relation("DealParticipants")
  activities   DealActivity[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type      String   // NOTE | EMAIL | CALL | MEETING | STATUS_CHANGE
  content   String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([dealId])
}

model DirectMessage {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("SentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("ReceivedMessages", fields: [toId], references: [id], onDelete: Cascade)
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fromId])
  @@index([toId])
  @@index([fromId, toId])
}

model DiscussionPost {
  id        String               @id @default(cuid())
  authorId  String
  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    Module?              @relation(fields: [moduleId], references: [id])
  content   String
  postType  String               @default("DISCUSSION")
  isPinned  Boolean              @default(false)
  isDeleted Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  replies   DiscussionReply[]
  reactions DiscussionReaction[]

  @@index([moduleId])
  @@index([authorId])
  @@index([createdAt])
}

model DiscussionReaction {
  id        String         @id @default(cuid())
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model DiscussionReply {
  id        String         @id @default(cuid())
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  isAnswer  Boolean        @default(false)
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([postId])
}

model EmailSequence {
  id          String                    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  steps       EmailSequenceStep[]
  enrollments EmailSequenceEnrollment[]
}

model EmailSequenceEnrollment {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceId  String
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id])
  currentStep Int           @default(1)
  status      String        @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | CANCELLED
  nextSendAt  DateTime?
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  @@unique([leadId, sequenceId])
  @@index([status, nextSendAt])
}

model EmailSequenceStep {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber Int
  subject    String
  body       String
  delayDays  Int           @default(0)

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
}

model EmailTemplate {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  subject      String
  body         String
  placeholders String   @default("")
  enabled      Boolean  @default(true)
  editable     Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt
  updatedBy    String?
}

model Event {
  id                  String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug                String              @unique
  title               String
  description         String?
  eventType           String              @default("IN_PERSON")  // IN_PERSON | ZOOM
  speakerName         String?
  speakerBio          String?
  speakerTitle        String?
  speakerImageUrl     String?
  location            String?
  venueAddress        String?
  meetingUrl          String?
  startsAt            DateTime @db.Timestamptz(6)
  endsAt              DateTime? @db.Timestamptz(6)
  timezone            String              @default("America/New_York")
  maxCapacity         Int?
  visibility          String              @default("PUBLIC")
  active              Boolean             @default(true)
  reminderSent7d      Boolean             @default(false)
  reminderSent24h     Boolean             @default(false)
  followUpSent        Boolean             @default(false)
  confirmationMessage String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  registrations       EventRegistration[]

  @@index([slug])
  @@index([startsAt])
  @@index([active, startsAt])
}

model EventRegistration {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firstName    String
  lastName     String
  email        String
  phone        String?
  leadId       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  referralCode String?
  contactType  String   @default("STUDENT")  // STUDENT | PARENT
  attendedAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([eventId, email])
  @@index([eventId])
}

model HelpArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  category  String   @default("GENERAL")
  published Boolean  @default(false)
  pinned    Boolean  @default(false)
  order     Int      @default(0)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, published])
}

model JobApplication {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  role      String
  url       String?
  // WISHLIST | APPLIED | PHONE_SCREEN | INTERVIEW | FINAL_ROUND | OFFER | REJECTED | WITHDRAWN
  status    String    @default("WISHLIST")
  source    String?   // LINKEDIN | REFERRAL | COLD_EMAIL | JOB_BOARD | COMPANY_SITE | EVENT | OTHER
  salary    String?
  location  String?
  notes     String?
  appliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  company     String?
  jobTitle    String?
  linkedinUrl String?

  // Pipeline
  stage       String   @default("LEAD")
  // LEAD | CONTACTED | APPLIED | STRATEGY_CALL | ADMITTED | OFFER_SENT | COMPLETED | ENROLLED | LOST

  source      String?
  // REFERRAL | LINKEDIN | WEBSITE | INSTAGRAM | COLD_EMAIL | EVENT | OTHER
  subSource   String?
  // For 3I_NEXTGEN source: MEMBER | NON_MEMBER_REFERRAL

  // UTM attribution — captured from landing page URL params
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  leadType    String?  @default("WAITLIST")
  // WAITLIST | APPLICATION | STUDENT | PARTNER | CONTACT

  // Who filled out the form — parents increasingly submit on behalf of students
  personaRole String?  // PARENT | STUDENT

  // Home ZIP (the student's family home) + geo appended server-side from ZIP
  zip         String?
  city        String?
  state       String?

  // Student contact info when a PARENT submitted the form
  studentFirstName String?
  studentLastName  String?
  studentEmail     String?
  studentPhone     String?

  lostReason    String?
  assignedTo    String?  // admin user email
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  paymentStatus String?  @default("UNPAID")
  // UNPAID | PAID_FULL | PAYMENT_PLAN | SCHOLARSHIP | OUTSTANDING
  dealValue   Int?     @default(0) // USD, whole dollars
  programType   String?  @default("STANDARD")
  // STANDARD | PAID_PILOT | PARTNER_COMPED
  cohortPartner String?  // "3i" | "Northwestern SPS" etc.
  tags        String[] @default([])
  notes       String?

  // Outcome tracking (post-graduation)
  outcomeStatus      String?   // PENDING | PLACED | STILL_SEARCHING | NOT_LOOKING
  outcomeCompany     String?
  outcomeRole        String?
  outcomeSalary      Int?      // annual USD, whole dollars
  outcomeStartDate   DateTime?
  outcomeNotes       String?
  outcomeUpdatedAt   DateTime?
  outcomeToken       String?   @unique // one-time token for the self-report form
  outcomeEmailSentAt DateTime?         // when we sent the follow-up email

  // Link to LMS user when converted to student
  enrolledUserId String? @unique
  enrolledUser   User?   @relation(fields: [enrolledUserId], references: [id])

  activities          LeadActivity[]
  tasks               Task[]
  sequenceEnrollments EmailSequenceEnrollment[]
  paymentRecords      PaymentRecord[]

  // Deals / Partnerships
  dealId          String?  // FK to Deal (participant in a deal)
  dealRef         Deal?    @relation("DealParticipants", fields: [dealId], references: [id])
  contactForDeals Deal[]   @relation("DealContact")

  promoCode    String?   // promo code applied at intake
  referralCode String?   // student referral code used at intake

  deletedAt    DateTime? // soft delete — null = active, non-null = in recycle bin
  unsubscribed Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([stage])
  @@index([deletedAt])
  @@index([deletedAt, updatedAt])
}

model LeadActivity {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String    // NOTE | EMAIL | CALL | MEETING | STAGE_CHANGE | ENROLLED | CREATED
  content   String?
  subject   String?   // email subject line
  emailTo   String?   // recipient email address
  source    String?   // COMPOSER | SEQUENCE | GMAIL_SYNC | TEMPLATE | BLAST | UNSUBSCRIBE
  metadata  String?   // JSON — used for stage_change { from, to }
  createdBy String?   // admin user id
  openedAt  DateTime? // set when tracking pixel is loaded (email opens)
  createdAt DateTime  @default(now())

  @@index([leadId])
  @@index([type, createdAt])
}

model LoginStreak {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int    @default(0)
  longestStreak Int    @default(0)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId])
  @@index([userId])
}

model Module {
  id          String       @id @default(cuid())
  number      Int          @unique
  title       String
  subtitle    String?
  description String?
  week        Int
  icon        String?
  unlocked    Boolean      @default(true)
  startDate       DateTime?
  preworkDue      DateTime?
  sessionDate     DateTime?
  sessionLocation String?
  sessionZoomLink String?
  sections          Section[]
  submissions       Submission[]
  progress          Progress[]
  attendance        AttendanceRecord[]
  cohortSchedules   CohortSchedule[]
  preworkQuestions  PreworkQuestion[]
  preworkSubmissions PreworkSubmission[]
  oneOnOneSlots     OneOnOneSlot[]
  oneOnOneBookings  OneOnOneBooking[]
  discussionPosts   DiscussionPost[]
  weeklyCheckins    WeeklyCheckin[]
  hotSeatSessions   HotSeatSession[]
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  moduleId  String
  content   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // FEEDBACK | APPROVED | NEEDS_REVISION | ANNOUNCEMENT
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, type, createdAt])
}

model OneOnOneBooking {
  id                 String       @id @default(cuid())
  slotId             String       @unique
  slot               OneOnOneSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentId          String
  student            User         @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  moduleId           String
  module             Module       @relation(fields: [moduleId], references: [id])
  status             String       @default("CONFIRMED") // CONFIRMED | CANCELLED
  preworkEmailSentAt DateTime?
  zoomMeetingId      String?      // Zoom meeting ID
  zoomJoinUrl        String?      // student join link
  zoomStartUrl       String?      // host start link (Dan's link)
  calendlyEventUri   String?      @unique // Calendly scheduled_event URI when booked via Calendly
  createdAt          DateTime     @default(now())

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
}

model OneOnOneSlot {
  id               String           @id @default(cuid())
  adminId          String
  admin            User             @relation("AdminSlots", fields: [adminId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime
  moduleId         String?
  module           Module?          @relation(fields: [moduleId], references: [id])
  isBooked         Boolean          @default(false)
  recurringGroupId String?
  createdAt        DateTime         @default(now())
  booking          OneOnOneBooking?

  @@index([startTime])
  @@index([adminId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model PaymentRecord {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount    Int
  note      String?
  paidAt    DateTime @default(now())
  createdBy String?

  @@index([leadId])
}

model PreworkAnswer {
  id           String            @id @default(cuid())
  submissionId String
  submission   PreworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     PreworkQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String

  @@unique([submissionId, questionId])
}

model PreworkNote {
  id         String   @id @default(cuid())
  userId     String   // student
  moduleId   String
  sectionKey String   // "general" | "session-questions" | "answer:<questionId>" | "worksheet:<worksheetId>"
  content    String
  authorId   String   // admin who wrote it
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation("PreworkNoteUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, moduleId, sectionKey])
}

model PreworkQuestion {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  question    String
  type        String   @default("textarea") // "text" | "textarea"
  placeholder String?
  required    Boolean  @default(true)
  createdAt   DateTime @default(now())
  answers     PreworkAnswer[]

  @@index([moduleId])
}

model PreworkSubmission {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submittedAt DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sessionQuestions String?
  reviewedAt  DateTime?
  answers     PreworkAnswer[]

  @@unique([userId, moduleId])
  @@index([moduleId])
  @@index([userId])
}

model ProgramTool {
  id            String   @id @default(cuid())
  name          String
  description   String   @default("")
  url           String?
  emoji         String   @default("🛠️")
  moduleNumbers Int[]    @default([])
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  sectionId   String?
  section     Section? @relation(fields: [sectionId], references: [id])
  completedAt DateTime @default(now())

  @@unique([userId, sectionId])
  @@index([userId, completedAt])
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String?
  discountPct Int?      // 0–100 percent off; null = tracking-only / access code
  maxUses     Int?      // null = unlimited
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model ReminderLog {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  type      String   // PREWORK | SESSION
  sentAt    DateTime @default(now())

  @@unique([userId, moduleId, type])
}

model Resource {
  id        String          @id @default(cuid())
  sectionId String
  section   Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type      String
  title     String
  url       String?
  filePath  String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  videoProgress VideoProgress[]
}

model Section {
  id            String           @id @default(cuid())
  moduleId      String
  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type          String
  title         String
  content       String?
  order         Int
  notionPageId  String?
  lastSyncedAt  DateTime?
  resources     Resource[]
  progress      Progress[]
  comments      SectionComment[]
}

model SectionComment {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  moduleId  String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  isPinned  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sectionId])
  @@index([moduleId])
}

model SessionTranscript {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  content   String
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, moduleId])
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  title       String
  content     String?
  fileUrl     String?
  fileName    String?
  status          String   @default("PENDING")
  feedback        String?
  aiFeedback      String?
  aiReviewedAt    DateTime?
  studentReply    String?
  studentRepliedAt DateTime?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
}

model SupportTicket {
  id                 String          @id @default(cuid())
  ticketNumber       Int             @unique @default(autoincrement())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject            String
  category           String          // TECHNICAL | CONTENT | COACHING | BILLING | OTHER
  description        String
  status             String          @default("OPEN") // OPEN | IN_PROGRESS | WAITING | RESOLVED | CLOSED
  priority           String          @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assigneeId         String?         // admin userId
  closedAt           DateTime?
  lastActivityAt     DateTime        @default(now())
  satisfactionRating Int?            // 1-5 after resolved
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  messages           TicketMessage[]

  @@index([userId])
  @@index([status])
}

model WeeklyCheckin {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  support     Int      // Q1, 1-5
  blocker     String   // Q2, "Nothing" is valid
  leastUseful String?  // Q3, optional on purpose
  gate        String   // Q4, the module gate answer
  submittedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, moduleId])
}

model OneOnOnePulse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId   String   @unique
  clearAction String   // Yes | Sort of | No
  unsaid      String?
  submittedAt DateTime @default(now()) @db.Timestamptz(6)
}

model InterventionFlag {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  owner      String    // DAN | CALEB
  detail     String
  dueBy      DateTime  @db.Timestamptz(6)
  moduleId   String?
  resolvedAt DateTime? @db.Timestamptz(6)
  resolvedBy String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
}

model GrowthBattery {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  point       String   // ORIENTATION | MID | FINALE
  answers     Json
  submittedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, point])
}

model SurveyResponse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  answers     Json
  submittedAt DateTime @default(now())

  // Individual rating fields (populated alongside answers Json)
  overallRating      Int?
  contentRating      Int?
  facilitatorRating  Int?
  practicalRating    Int?
  wouldRecommend     Boolean?
  biggestTakeaway    String?
  improveSuggestion  String?
  additionalComments String?

  @@unique([userId, moduleId])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  createdBy   String?
  assignedTo  String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([dueAt])
}

model ThreeSixtyResponse {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  responderName String
  relationship  String?
  answers       Json
  createdAt     DateTime @default(now())

  @@index([userId])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorRole String        // STUDENT | ADMIN
  content    String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  password    String
  role        String       @default("STUDENT")
  cohort               String?
  cohortId             String?
  cohortRef            Cohort?   @relation(fields: [cohortId], references: [id])
  onboardedAt          DateTime?
  xpPoints             Int          @default(0)
  createdAt            DateTime     @default(now())
  certificateIssuedAt  DateTime?
  notionAccessToken    String?
  notionWorkspaceName  String?
  notionWorkspaceIcon  String?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  timezone             String    @default("America/New_York")
  crmRole              String?   // ADMIN | MEMBER — CRM access role; null = LMS-only student
  calendlyUrl          String?   // coach Calendly scheduling link (admins only)
  officeHoursUrl       String?   // office-hours Calendly link (admins only) — quick-help bookings
  mcpToken             String?   @unique // personal access token for the Claude MCP connector
  threeSixtyToken      String?   @unique // public 360-ask link token
  calendarToken        String?   @unique // self-authenticating calendar subscription feed
  invitedAt            DateTime? @db.Timestamptz(6) // invite email sent; distinct from onboardedAt
  /// Per-person UI preferences that should follow the account, not the browser.
  uiPrefs              Json?
  threeSixtyResponses  ThreeSixtyResponse[]
  gmailRefreshToken    String?
  gmailEmail           String?
  gmailSyncedAt        DateTime?
  submissions          Submission[]
  progress             Progress[]
  notes                Note[]
  coachingNotes        CoachingNote[]
  worksheetResponses   WorksheetResponse[]
  surveyResponses      SurveyResponse[]
  growthBatteries      GrowthBattery[]
  weeklyCheckins       WeeklyCheckin[]
  oneOnOnePulses       OneOnOnePulse[]
  interventionFlags    InterventionFlag[]
  notifications        Notification[]
  hotSeatTurns         HotSeatTurn[]
  hotSeatReceived      HotSeatFeedback[]    @relation("HotSeatSubject")
  hotSeatGiven         HotSeatFeedback[]    @relation("HotSeatAuthor")
  supportTickets       SupportTicket[]
  passwordResetTokens  PasswordResetToken[]
  bridgeTokens         CrmBridgeToken[]
  attendanceRecords    AttendanceRecord[]
  crmLead              Lead?
  preworkSubmissions   PreworkSubmission[]
  oneOnOneSlots        OneOnOneSlot[]       @relation("AdminSlots")
  oneOnOneBookings     OneOnOneBooking[]    @relation("StudentBookings")
  discussionPosts      DiscussionPost[]
  discussionReplies    DiscussionReply[]
  discussionReactions  DiscussionReaction[]
  videoProgress        VideoProgress[]
  sectionComments      SectionComment[]
  sentMessages         DirectMessage[]  @relation("SentMessages")
  receivedMessages     DirectMessage[]  @relation("ReceivedMessages")
  jobApplications      JobApplication[]
  loginStreaks         LoginStreak[]
  moduleViews          ModuleView[]
  ledgerEvents         LedgerEvent[]
  referralCode         String?   @unique

  preworkNotesAbout PreworkNote[] @relation("PreworkNoteUser")
}

model VideoProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  moduleId        String
  percentWatched  Float    @default(0)
  watchedSeconds  Int      @default(0)
  durationSeconds Int?
  completedAt     DateTime?
  lastWatchedAt   DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
  @@index([moduleId])
}

model WorksheetResponse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  worksheetId String
  rows        Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, moduleId, worksheetId])
}

model ModuleView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  sectionId String?
  viewedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, moduleId])
  @@index([userId])
}

/// One Hot Seat round: a cohort works through a module's spike statements out
/// loud while the rest of the room files feedback in real time. Dan's fix for
/// the engagement problem — nobody sits waiting for their turn.
model HotSeatSession {
  id        String    @id @default(cuid())
  cohortId  String
  cohort    Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  /// DRAFT (building the order) | OPEN (room is submitting) | CLOSED (feedback released)
  status    String    @default("DRAFT")
  createdBy String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  openedAt  DateTime? @db.Timestamptz(6)
  closedAt  DateTime? @db.Timestamptz(6)
  turns     HotSeatTurn[]
  feedback  HotSeatFeedback[]

  @@index([cohortId, moduleId])
}

/// A Fellow's slot in the running order. Set before the session so peers pick a
/// name instead of typing one mid-room; `absent` covers whoever didn't show.
model HotSeatTurn {
  id        String  @id @default(cuid())
  sessionId String
  session   HotSeatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Int
  absent    Boolean @default(false)
  /// The spike sentence as read to the room, captured so feedback stays legible later.
  spikeLine String?

  @@unique([sessionId, userId])
}

/// One peer's feedback on one Fellow's spike statement. `checks` holds the four
/// rubric keys (c3–c6) so the survey, the LMS rubric and the deck stay one thing.
/// Fellows read this anonymised; admins see the author.
model HotSeatFeedback {
  id            String   @id @default(cuid())
  sessionId     String
  session       HotSeatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjectUserId String
  subject       User     @relation("HotSeatSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  authorUserId  String
  author        User     @relation("HotSeatAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  checks        Json?
  comment       String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([sessionId, subjectUserId, authorUserId])
  @@index([subjectUserId])
}

/// Append-only record of what each Fellow actually did.
///
/// Backs the one-year guarantee: a refund decision cannot rest on live rows,
/// because those change. UPDATE and DELETE are refused by a database trigger,
/// and each row carries the hash of the row before it, so tampering is
/// detectable rather than merely discouraged. Corrections are new events.
model LedgerEvent {
  id             String   @id
  seq            BigInt   @unique @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohortId       String?
  moduleId       String?
  type           String
  occurredAt     DateTime @db.Timestamptz(6)
  recordedAt     DateTime @default(now()) @db.Timestamptz(6)
  source         String   @default("APP")
  detail         Json?
  idempotencyKey String   @unique
  prevHash       String?
  hash           String

  @@index([userId])
  @@index([cohortId, type])
}
